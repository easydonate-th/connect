{
  "name": "@ezdn/connect",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path || true",
    "dev": "bun --bun turbo run dev",
    "build": "bun --bun turbo run build",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "ultracite": "8.2.0"
  },
  "packageManager": "bun@1.4.4"
}
