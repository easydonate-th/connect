.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Electrobun release artifacts
/apps/desktop/artifacts/

# Unity project (apps/unity/)
/apps/unity/[Ll]ibrary/
/apps/unity/[Tt]emp/
/apps/unity/[Oo]bj/
/apps/unity/[Bb]uild/
/apps/unity/[Bb]uilds/
/apps/unity/[Ll]ogs/
/apps/unity/[Uu]ser[Ss]ettings/
/apps/unity/[Mm]emoryCaptures/
/apps/unity/[Rr]ecordings/
/apps/unity/.utmp/

# Generated by the VRChat SDK / UdonSharp on compile & build
/apps/unity/Assets/SerializedUdonPrograms/
/apps/unity/Assets/SerializedUdonPrograms.meta

# VPM-resolved packages are installed into Packages/ by VCC — only track
# the manifests and our own package
/apps/unity/Packages/*
!/apps/unity/Packages/manifest.json
!/apps/unity/Packages/packages-lock.json
!/apps/unity/Packages/vpm-manifest.json
!/apps/unity/Packages/com.easydonate.vrc/

# IDE-generated solution / project files
/apps/unity/*.csproj
/apps/unity/*.unityproj
/apps/unity/*.sln
/apps/unity/*.slnx
/apps/unity/*.suo
/apps/unity/*.user
/apps/unity/*.userprefs
/apps/unity/*.pidb
/apps/unity/*.booproj
/apps/unity/*.svd
/apps/unity/*.pdb
/apps/unity/*.mdb
/apps/unity/*.opendb
/apps/unity/*.VC.db
/apps/unity/.vs/
/apps/unity/.vsconfig.user
/apps/unity/Assets/Plugins/Editor/JetBrains*

# Unity debug / build leftovers
*.pidb.meta
*.pdb.meta
*.mdb.meta
/apps/unity/sysinfo.txt
/apps/unity/crashlytics-build.properties
/apps/unity/*.unitypackage
/apps/unity/*.unitypackage.meta

# Editors / OS
.idea/
.vs/
*.swp
Thumbs.db
desktop.ini
